<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{nombre1}} & {{nombre2}}</title>
  <link rel="stylesheet" href="public/css/style.css?v=3">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css">
</head>
<body class="pagina-inicio" data-tema-actual="azul">

  <!-- Datos de todas las secciones (tema + canción) para el reproductor -->
  <script id="datos-secciones" type="application/json">{{{secciones_json}}}</script>

  <!-- ===== Indicador lateral tipo línea de tiempo ===== -->
  <nav class="nav-puntos" aria-label="Recorrido de la historia">
    {{#secciones}}
      <button class="punto" data-target="{{id}}" title="{{label}}">
        <span class="punto-etiqueta">{{label}}</span>
      </button>
    {{/secciones}}
  </nav>

  <!-- ===== Reproductor fijo ===== -->
  <div class="reproductor" id="reproductor">
    <div class="reproductor-nota" id="reproductor-nota"></div>
    <div class="reproductor-fila">
      <div class="reproductor-info">
        <span class="reproductor-titulo" id="reproductor-titulo">—</span>
        <span class="reproductor-artista" id="reproductor-artista">Tocá play para empezar</span>
      </div>
      <div class="reproductor-controles">
        <button id="btn-anterior" title="Anterior" aria-label="Canción anterior">⏮</button>
        <button id="btn-play" title="Reproducir" aria-label="Reproducir o pausar">▶</button>
        <button id="btn-siguiente" title="Siguiente" aria-label="Canción siguiente">⏭</button>
      </div>
    </div>
    <div class="reproductor-progreso">
      <input type="range" id="barra-progreso" min="0" max="100" value="0" step="0.1" aria-label="Progreso de la canción">
    </div>
    <div class="reproductor-fila reproductor-fila-chica">
      <button id="btn-modo-historia" class="chip-modo-historia activo" title="Modo historia: la música sigue el scroll">
        🔗 Modo historia
      </button>
      <div class="reproductor-volumen">
        <button id="btn-mute" title="Silenciar" aria-label="Silenciar">🔊</button>
        <input type="range" id="barra-volumen" min="0" max="1" step="0.01" value="0.8" aria-label="Volumen">
      </div>
    </div>
  </div>

  <audio id="audio-reproductor" preload="none"></audio>

  <!-- ===== Hero / Introducción ===== -->
  <section class="seccion hero seccion-hero tema-azul" id="intro" data-seccion-id="intro" data-tema="azul"
    style="background-image:url('public/images/portada.jpg')">
    <div class="hero-overlay">
      <h1 data-aos="fade-up">{{nombre1}} & {{nombre2}}</h1>
      <p class="hero-subtitulo" data-aos="fade-up" data-aos-delay="150">
        Nuestra historia, desde el día que nos cruzamos hasta hoy.
      </p>
      <button class="scroll-cue" id="btn-empezar" aria-label="Empezar la historia">↓</button>
    </div>
  </section>

  <!-- ===== Cada hito es su propia sección/capítulo, con su tema y su canción ===== -->
 {{#hitos}}
  <section class="seccion seccion-hito tema-{{tema}}" id="{{id}}" data-seccion-id="{{id}}" data-tema="{{tema}}">
    {{#es_tags}}
      <div class="hito-tags-layout" data-aos="fade-up">
        <h3 class="hito-titulo">{{titulo}}</h3>
        <p class="hito-mensaje">{{mensaje}}</p>

        <div class="fila-fotos">
          {{#fotos_fila}}
            <img src="{{ruta}}" alt="{{descripcion}}">
          {{/fotos_fila}}
        </div>

        {{#tiene_extra}}
          <button class="btn-ver-mas" data-target="{{galeria_id}}">Ver más fotos</button>
        {{/tiene_extra}}
       <div class="galeria-extra-marquee" id="{{galeria_id}}">
  <div class="marquee-fila marquee-der">
    {{#galeria_fila1}}<img src="{{ruta}}" alt="{{descripcion}}">{{/galeria_fila1}}
  </div>
  <div class="marquee-fila marquee-izq">
    {{#galeria_fila2}}<img src="{{ruta}}" alt="{{descripcion}}">{{/galeria_fila2}}
  </div>
</div>

        {{#tiene_tags}}
          <div class="lista-tags">
            {{#tags}}<span class="tag-pill">{{.}}</span>{{/tags}}
          </div>
        {{/tiene_tags}}
      </div>
    {{/es_tags}}

    {{^es_tags}}
      <div class="hito {{alineacion}}" data-aos="fade-up">
        <div class="hito-texto">
          <p class="hito-titulo">{{titulo}}</p>
          <p class="hito-fecha">{{fecha}}</p>
          <p class="hito-mensaje">{{mensaje}}</p>
          {{#tiene_extra}}
            <button class="btn-ver-mas" data-target="{{galeria_id}}">Ver más fotos</button>
          {{/tiene_extra}}
        </div>
        {{#tiene_fotos}}
        <div class="hito-foto pila-fotos">
          {{#fotos_pila}}
            <img src="{{ruta}}" alt="{{descripcion}}" style="--angulo: {{angulo}}deg;">
          {{/fotos_pila}}
        </div>
        {{/tiene_fotos}}
        <div class="galeria-extra-marquee" id="{{galeria_id}}">
  <div class="marquee-fila marquee-der">
    {{#galeria_fila1}}<img src="{{ruta}}" alt="{{descripcion}}">{{/galeria_fila1}}
  </div>
  <div class="marquee-fila marquee-izq">
    {{#galeria_fila2}}<img src="{{ruta}}" alt="{{descripcion}}">{{/galeria_fila2}}
  </div>
</div>
      </div>
    {{/es_tags}}
  </section>
{{/hitos}}

  <!-- ===== Viajes ===== -->
  <section class="seccion seccion-viajes tema-celeste" id="{{viajes.id}}" data-seccion-id="{{viajes.id}}" data-tema="{{viajes.tema}}">
    <h2 data-aos="fade-up">Nuestros viajes</h2>
    <!-- Un viaje por álbum marcado como "es_viaje", con sus fotos. El JS
         (iniciarCarruselViajes en main.js) arma el carrusel a partir de
         este JSON: pasa las fotos de un viaje y, al terminar, sigue
         automáticamente con el próximo viaje. -->
    <script id="datos-viajes" type="application/json">{{{viajes_json}}}</script>
<div class="carrusel-viajes-wrap" data-aos="fade-up" data-aos-delay="100">
  <button class="carrusel-flecha carrusel-flecha-izq" id="carrusel-viajes-prev" aria-label="Lugar anterior">‹</button>

  <div class="carrusel-viaje-actual" id="carrusel-viaje-actual">
    <h3 class="carrusel-viaje-titulo" id="carrusel-viaje-titulo"></h3>
    <div class="tira-viajes" id="carrusel-viajes"></div>
  </div>

  <button class="carrusel-flecha carrusel-flecha-der" id="carrusel-viajes-next" aria-label="Lugar siguiente">›</button>
</div>
  </section>

<!-- ===== Nuestros pasatiempos ===== -->
<section class="seccion seccion-series tema-negro" id="{{series_seccion.id}}" data-seccion-id="{{series_seccion.id}}" data-tema="{{series_seccion.tema}}">
  <h2 data-aos="fade-up">Nuestros pasatiempos entre mates, cenas y almuerzos</h2>
  <div class="grid-series" data-aos="fade-up" data-aos-delay="100">
    {{#series}}
      <div class="tarjeta-serie">
        {{#imagen}}<img src="{{imagen}}" alt="{{nombre}}">{{/imagen}}
        <h3>{{nombre}}</h3>
      </div>
    {{/series}}
  </div>
</section>

  <!-- ===== Contador ===== -->
<section class="seccion seccion-contador tema-violeta" id="{{contador_seccion.id}}" data-seccion-id="{{contador_seccion.id}}" data-tema="{{contador_seccion.tema}}">
  <h2 class="contador-titulo" data-aos="fade-up">Oficialmente de novios desde el 01/08/2023</h2>
  <div class="contador-grande" id="contador" data-inicio="{{fecha_inicio}}" data-aos="zoom-in"></div>
  <p class="contador-subtitulo" data-aos="fade-up">Y nos conocemos desde el 11/12/2020</p>
</section>
<!-- ===== Carta que se da vuelta ===== -->
<section class="seccion seccion-carta tema-rosa" id="carta" data-seccion-id="carta" data-tema="rosa">
  <div class="carta" id="carta-giratoria" data-aos="zoom-in">
    <div class="carta-cara carta-frente">
      <img src="public/images/caricatura.jpg" alt="Caricatura de los dos">
    </div>
    <div class="carta-cara carta-dorso">
      <p>Te ama,<br>Cecilia</p>
    </div>
  </div>
</section>

  <!-- ===== Final ===== -->
  <section class="seccion seccion-final tema-blanco" id="final" data-seccion-id="final" data-tema="blanco">
    <div class="final-contenido" data-aos="fade-up">
      <p class="final-eyebrow">{{nombre1}} & {{nombre2}}</p>
      <h2>Y esto recién empieza.</h2>
      <p class="final-texto"></p>
    </div>
  </section>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
  <script>AOS.init({ once: true, duration: 700 });</script>
  <script src="public/js/main.js?v=3"></script>
  <script src="public/js/reproductor.js?v=3"></script>
</body>
</html>
