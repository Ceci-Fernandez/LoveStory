<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Nuestra música</title>
  <link rel="stylesheet" href="public/css/style.css">
</head>
<body>
  <h1>Música</h1>
  <div class="lista-canciones">
    {{#canciones}}
      <div class="tarjeta-cancion">
        <h3>{{titulo}}</h3>
        <p>{{artista}}</p>
        {{#spotify_url}}
          <iframe src="{{spotify_url}}" width="100%" height="80" frameborder="0"></iframe>
        {{/spotify_url}}
      </div>
    {{/canciones}}
  </div>
</body>
</html>
